# WSK 专用模板：复制为 .env.wsk。旧项目 .env 不参与本项目部署。
# docker compose --env-file .env.wsk -p wsk-auto up -d --build
# 下列凭证仅供本地开发；生产请单独生成，不复用原项目凭证。
WSK_MYSQL_ROOT_PASSWORD=wsk-local-root
WSK_MYSQL_DB_NAME=wsk_auto
WSK_MYSQL_USER=wsk
WSK_MYSQL_PASSWORD=wsk-local-db
WSK_JWT_SECRET=wsk-local-only-change-before-production
WSK_GRAFANA_ADMIN_PASSWORD=wsk-local-grafana
WSK_TAG=latest
WSK_MYSQL_HOST_PORT=13316
WSK_GATEWAY_HOST_PORT=18090
WSK_ES_HOST_PORT=19210
WSK_ROCKETMQ_PROXY_HOST_PORT=18091
WSK_ROCKETMQ_DASHBOARD_HOST_PORT=28090
WSK_JAEGER_UI_HOST_PORT=26696
WSK_JAEGER_OTLP_HOST_PORT=14327
WSK_PROM_HOST_PORT=19090
WSK_GRAFANA_HOST_PORT=13010
WSK_REDIS_HOST_PORT=16389
